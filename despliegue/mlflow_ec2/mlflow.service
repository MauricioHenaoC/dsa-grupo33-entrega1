[Unit]
Description=Servidor de seguimiento MLflow - grupo 33
Wants=network-online.target
After=network-online.target

[Service]
# Desactiva la ejecución de tareas en el servidor (procesos huey_consumer).
# No se usa en este proyecto y, en una t3.small, hacía que MLflow se cayera
# y se reiniciara solo (página en blanco, ERR_CONNECTION_RESET).
Environment=MLFLOW_SERVER_ENABLE_JOB_EXECUTION=false
User=ubuntu
WorkingDirectory=/home/ubuntu/mlflow
ExecStart=/home/ubuntu/mlflow/iniciar_mlflow.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
